# Copy this file to .env and fill in keys. Never commit .env.
#   cp .env.example .env
# Then restart Streamlit / the CLI so they pick up the new values.

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Kimi / Moonshot (OpenAI-compatible)
# Key from platform.kimi.ai. Base URL is correct; model id lives in config.yaml (kimi-k2.6).
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1
